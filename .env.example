# Copy to .env and edit: `cp .env.example .env`. docker compose reads this file
# both for ${...} substitution in docker-compose.yml and as the container's
# environment. Every variable is optional; the defaults are shown.

# ---------------------------------------------------------------------------
# docker compose (host side)
# ---------------------------------------------------------------------------
# Image to run. GitHub Actions publishes ghcr.io/<owner>/<repo> (lower case);
# pin a tag such as :0.1.0 (from git tag v0.1.0) or :sha-<short-sha>
# instead of :latest if you like.
CRYPTOPREDICT_IMAGE=ghcr.io/aydinozturk/cyrpto-predict:latest
# Host address the dashboard port is published on. 127.0.0.1 = this machine
# only. Use 0.0.0.0 to expose it on the network, and then also set
# CRYPTOPREDICT_DASHBOARD_TOKEN below.
CRYPTOPREDICT_BIND=127.0.0.1
# Host port -> container port 8000.
CRYPTOPREDICT_PUBLISH_PORT=8000
# Optional dependency groups for `docker compose build` (comma-separated, no
# spaces; keep `web`). Add `deep` for the LSTM/GRU models: CPU-only PyTorch,
# roughly 1 GB more image. Set CRYPTOPREDICT_IMAGE to a local tag such as
# cryptopredict:deep so the build does not shadow the published image.
CRYPTOPREDICT_EXTRAS=web,ml

# ---------------------------------------------------------------------------
# dashboard (container side)
# ---------------------------------------------------------------------------
# Bearer token for every /api/* endpoint except /api/health. Empty = no auth:
# anyone who can reach the port can fetch data, train, delete models.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRYPTOPREDICT_DASHBOARD_TOKEN=
# Defaults pre-selected in the dashboard forms.
CRYPTOPREDICT_DEFAULT_SYMBOL=BTCUSDT
CRYPTOPREDICT_DEFAULT_INTERVAL=1h
# Binance REST base URL used for downloading candles (e.g. a regional mirror
# such as https://api.binance.us or https://data-api.binance.vision).
CRYPTOPREDICT_BINANCE_URL=https://api.binance.com

# Set by the image and pinned by docker-compose.yml (data lives in the
# cryptopredict-data volume). Only relevant when running `cryptopredict-web`
# outside Docker, where the defaults are ./data, ./models, 0.0.0.0 and 8000.
# CRYPTOPREDICT_DATA_DIR=/data/cache
# CRYPTOPREDICT_MODEL_DIR=/data/models
# CRYPTOPREDICT_HOST=0.0.0.0
# CRYPTOPREDICT_PORT=8000
